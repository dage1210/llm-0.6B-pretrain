五、下载数据脚本
pip install -U modelscope -i https://pypi.tuna.tsinghua.edu.cn/simple

modelscope download --dataset opencsg/chinese-fineweb-edu-v2 \
    --include 'data/part-0[0-9]*.parquet' --local_dir ~/datallm/aug/cn-edu

modelscope download --dataset BAAI/CCI3-HQ \
    --include 'data/*000[0-4][0-9].jsonl' --local_dir ~/datallm/aug/cci3-hq

modelscope download --dataset opencsg/chinese-cosmopedia \
    --local_dir ~/datallm/aug/cn-cosmo              # 70 GB 全量

modelscope download --dataset AI-ModelScope/fineweb-edu \
    --include 'data/CC-MAIN-2024*' --local_dir ~/datallm/aug/en-edu

modelscope download --dataset AI-ModelScope/starcoderdata \
    --include 'python/*' --include 'java/*' --include 'javascript/*' \
    --include 'c/*' --include 'cpp/*' --include 'go/*' --include 'rust/*' \
    --include 'sql/*' --include 'shell/*' --include 'markdown/*' \
    --local_dir ~/datallm/aug/code

modelscope download --dataset AI-ModelScope/finemath \
    --include 'finemath-3plus/*' --local_dir ~/datallm/aug/math

  
